# CodeSentinel configuration (copy to .env). Every value is optional.

# --- Optional AI reasoning (Google Gemini). Without a key CodeSentinel runs
# --- fully on its deterministic analysis engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45

# --- Limits for untrusted input
CS_MAX_UPLOAD_MB=50
CS_MAX_FILES=5000
CS_MAX_UNCOMPRESSED_MB=200
CS_MAX_FILE_KB=1024
CS_GITHUB_TIMEOUT_SECONDS=60

# --- Server
CS_HOST=127.0.0.1
CS_PORT=5000
CS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CS_DATA_DIR=backend/data
